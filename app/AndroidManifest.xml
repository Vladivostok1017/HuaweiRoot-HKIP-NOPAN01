<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.l5.root"
    android:versionCode="4"
    android:versionName="0.4">

    <uses-sdk android:minSdkVersion="31" android:targetSdkVersion="31" />

    <!-- v0 的通道是 /sdcard/l5/：应用写请求、shell 半读请求。
         /sdcard 对 untrusted_app 与 shell 都可达，避开 SELinux 的 socket 权限问题。
         后续换成 Binder 服务时这些权限可以去掉。 -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- Shizuku 客户端：服务端以 shell/root 身份把 binder 投递进这个 provider -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <!-- 供其它 App 调用的门：content://com.l5.root.gateway -->
    <permission
        android:name="com.l5.root.permission.EXEC"
        android:protectionLevel="normal" />
    <application
        android:label="L5 Root"
        android:allowBackup="false"
        android:requestLegacyExternalStorage="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <provider
            android:name=".GatewayProvider"
            android:authorities="com.l5.root.gateway"
            android:exported="true"
            android:readPermission="com.l5.root.permission.EXEC"
            android:writePermission="com.l5.root.permission.EXEC" />
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="com.l5.root.shizuku"
            android:multiprocess="false"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
        <meta-data
            android:name="moe.shizuku.client.V3_SUPPORT"
            android:value="true" />
        <service
            android:name=".RootExecService"
            android:exported="false" />
    </application>
</manifest>
